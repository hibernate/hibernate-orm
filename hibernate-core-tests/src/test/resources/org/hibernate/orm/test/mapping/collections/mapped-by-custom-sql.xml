<?xml version="1.0"?>
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 version="8.0">
    <entity class="org.hibernate.orm.test.mapping.collections.MappedByCustomSqlTest$XmlGroup" access="FIELD">
        <attributes>
            <id name="id"/>
            <many-to-many name="children"/>
            <many-to-many name="parents" mapped-by="children">
                <sql-delete-all>delete from XmlGroup_XmlGroup where children_id = ?</sql-delete-all>
            </many-to-many>
        </attributes>
    </entity>
</entity-mappings>
