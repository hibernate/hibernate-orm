<?xml version="1.0"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping"
                 version="8.0">
    <entity class="org.hibernate.orm.test.boot.models.xml.attr.AuditedXmlAttributeTests$SimpleEntity" metadata-complete="true" access="FIELD">
        <audited>
            <audited-table name="SIMPLE_AUD"
                           changeset-id-column="CS_ID"
                           modification-type-column="CS_TYPE"
                           invalidating-changeset-id-column="CS_END"/>
        </audited>

        <attributes>
            <id name="id"/>
            <basic name="excluded">
                <exclude-from-auditing/>
            </basic>
            <element-collection name="strings">
                <column name="string_val"/>
                <collection-table name="simple_strings">
                    <join-column name="entity_id"/>
                </collection-table>
                <audited/>
            </element-collection>
        </attributes>
    </entity>
</entity-mappings>
