<?xml version="1.0"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping"
                 version="8.0">
    <entity class="org.hibernate.orm.test.boot.models.xml.attr.ChangelogXmlAttributeTests$SimpleChangelog"
            metadata-complete="true" access="FIELD">
        <changelog listener="org.hibernate.orm.test.boot.models.xml.attr.ChangelogXmlAttributeTests$SimpleChangesetListener"/>

        <attributes>
            <id name="id">
                <generated-value/>
                <changeset-id/>
            </id>
            <basic name="timestamp">
                <changelog-timestamp/>
            </basic>
            <element-collection name="modifiedEntities">
                <column name="entity_name"/>
                <collection-table name="simple_changelog_entities">
                    <join-column name="changeset_id"/>
                </collection-table>
                <changelog-modified-entities/>
            </element-collection>
        </attributes>
    </entity>
</entity-mappings>
