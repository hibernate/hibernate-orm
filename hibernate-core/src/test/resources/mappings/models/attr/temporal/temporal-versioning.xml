<?xml version="1.0"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping"
                 version="8.0">
    <entity class="org.hibernate.orm.test.boot.models.xml.attr.TemporalVersioningTests$SimpleEntity" metadata-complete="true" access="FIELD">
        <temporal-versioning row-start="eff_from" row-end="eff_to" second-precision="6">
            <history-partitioning current-partition="cur" history-partition="hist"/>
            <history-table name="SIMPLE_HISTORY"/>
        </temporal-versioning>

        <attributes>
            <id name="id"/>
            <basic name="excluded">
                <exclude-from-temporal-versioning/>
            </basic>
            <element-collection name="strings">
                <column name="string_val"/>
                <collection-table name="simple_strings">
                    <join-column name="entity_id"/>
                </collection-table>
                <temporal-versioning/>
            </element-collection>
        </attributes>
    </entity>
</entity-mappings>
