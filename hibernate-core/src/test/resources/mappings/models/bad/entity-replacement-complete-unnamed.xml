    <entity class="SimpleEntity" metadata-complete="true" access="FIELD">
        <attributes>
            <id name="id">
                <column name="original_id"/>
            </id>
            <basic name="name">
                <column name="original_name"/>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
