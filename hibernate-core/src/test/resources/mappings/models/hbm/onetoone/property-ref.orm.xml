<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping" version="9.0">
    <package>org.hibernate.orm.test.boot.models.hbm.onetoone</package>
    <access>FIELD</access>
    <entity class="ConstrainedOneToOneTests$CodedParent"><table name="coded_parent_t"/><attributes>
        <id name="id"/><basic name="code"><column unique="true" nullable="false"/></basic>
    </attributes></entity>
    <entity class="ConstrainedOneToOneTests$ConstrainedRefChild"><table name="constrained_ref_child_t"/><attributes>
        <id name="id"/><many-to-one name="parent" optional="false">
            <join-column name="id" referenced-column-name="code" insertable="false" updatable="false"/>
            <property-ref name="code"/>
        </many-to-one>
    </attributes></entity>
    <entity class="ConstrainedOneToOneTests$RefChild"><table name="ref_child_t"/><attributes>
        <id name="id"/><many-to-one name="parent">
            <join-column name="id" referenced-column-name="code" insertable="false" updatable="false"/>
            <foreign-key constraint-mode="NO_CONSTRAINT"/>
            <property-ref name="code"/>
        </many-to-one>
    </attributes></entity>
</entity-mappings>
