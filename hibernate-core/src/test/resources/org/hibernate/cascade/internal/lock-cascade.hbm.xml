<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping default-access="field">
    <class name="org.hibernate.cascade.internal.CascadeLockRemovalTest$Parent"
           table="cascade_lock_parent">
        <id name="id"/>
        <many-to-one name="child"
                     class="org.hibernate.cascade.internal.CascadeLockRemovalTest$Child"
                     cascade="lock"/>
    </class>

    <class name="org.hibernate.cascade.internal.CascadeLockRemovalTest$Child"
           table="cascade_lock_child">
        <id name="id"/>
    </class>
</hibernate-mapping>
