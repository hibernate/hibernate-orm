<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 version="8.0">

    <entity class="org.hibernate.orm.test.cid.xml.Event" access="FIELD">
        <table name="gv_events"/>
        <attributes>
            <embedded-id name="id">
                <generated-value generator="eventIdGen"/>
                <generic-generator name="eventIdGen"
                                   class="org.hibernate.orm.test.cid.xml.EventIdGenerator"/>
            </embedded-id>
            <basic name="name"/>
        </attributes>
    </entity>

    <embeddable class="org.hibernate.orm.test.cid.xml.EventId" access="FIELD">
        <attributes>
            <basic name="region"/>
            <basic name="sequence"/>
        </attributes>
    </embeddable>

</entity-mappings>
