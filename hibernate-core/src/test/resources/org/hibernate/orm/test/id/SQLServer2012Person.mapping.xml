<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping"
				 version="8.0">
	<package>org.hibernate.orm.test.id</package>
	<entity class="Person" metadata-complete="true">
		<attributes>
			<id name="id">
				<generated-value strategy="SEQUENCE" generator="sqlserver_person_seq"/>
				<sequence-generator name="sqlserver_person_seq" initial-value="10"/>
			</id>
		</attributes>
	</entity>
</entity-mappings>
