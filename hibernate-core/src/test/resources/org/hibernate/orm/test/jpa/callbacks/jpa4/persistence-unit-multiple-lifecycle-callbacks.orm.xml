<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping" version="8.0">
    <persistence-unit-metadata>
        <persistence-unit-defaults>
            <entity-listeners>
                <entity-listener class="org.hibernate.orm.test.jpa.callbacks.jpa4.PersistenceUnitLifecycleXmlMultipleCallbackTests$MultiElementListener">
                    <post-create method-name="factoryCreated"/>
                    <post-create method-name="managerCreated"/>
                    <pre-close method-name="factoryClosing"/>
                    <pre-close method-name="managerClosing"/>
                </entity-listener>
                <entity-listener class="org.hibernate.orm.test.jpa.callbacks.jpa4.PersistenceUnitLifecycleXmlMultipleCallbackTests$OverloadedListener">
                    <post-create method-name="created"/>
                    <pre-close method-name="closing"/>
                </entity-listener>
            </entity-listeners>
        </persistence-unit-defaults>
    </persistence-unit-metadata>
</entity-mappings>
