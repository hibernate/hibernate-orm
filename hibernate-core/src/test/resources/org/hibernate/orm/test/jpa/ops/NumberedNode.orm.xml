<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping" version="8.0">
    <package>org.hibernate.orm.test.jpa.ops</package>
    <attribute-accessor>property</attribute-accessor>
    <mapped-superclass class="org.hibernate.orm.test.jpa.ops.Node" access="PROPERTY" metadata-complete="true">
        <attributes>
            <basic name="name">
                <column name="name" nullable="false"/>
            </basic>
            <basic name="description"/>
            <transient name="parent"/>
            <transient name="children"/>
        </attributes>
    </mapped-superclass>
    <entity class="NumberedNode" metadata-complete="true">
        <table name="NumberedNode"/>
        <attributes>
            <id name="id">
                <generated-value strategy="IDENTITY"/>
            </id>
        </attributes>
    </entity>
</entity-mappings>
