            <id name="organizationName">
                <java-type>org.hibernate.type.descriptor.java.StringJavaType</java-type>
                <jdbc-type>org.hibernate.type.descriptor.jdbc.VarcharJdbcType</jdbc-type>
            </id>
            <basic name="startDate" fetch="EAGER" optional="true" optimistic-lock="true">
                <column unique="false" nullable="true" updatable="false"/>
                <generated>NEVER</generated>
                <java-type>org.hibernate.type.descriptor.java.DateJavaType</java-type>
                <jdbc-type>org.hibernate.type.descriptor.jdbc.TimestampJdbcType</jdbc-type>
            </basic>
            <basic name="endDate" fetch="EAGER" optional="true" optimistic-lock="true">
                <generated>NEVER</generated>
                <java-type>org.hibernate.type.descriptor.java.DateJavaType</java-type>
                <jdbc-type>org.hibernate.type.descriptor.jdbc.TimestampJdbcType</jdbc-type>
            </basic>
        </attributes>
