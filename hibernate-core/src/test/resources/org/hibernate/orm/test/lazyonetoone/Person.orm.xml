                <java-type>org.hibernate.type.descriptor.java.StringJavaType</java-type>
                <jdbc-type>org.hibernate.type.descriptor.jdbc.VarcharJdbcType</jdbc-type>
            </id>
            <one-to-many name="employments" target-entity="Employment" fetch="EAGER" fetch-mode="JOIN" mapped-by="personName" orphan-removal="false" classification="BAG" not-found="EXCEPTION" optimistic-lock="true">
