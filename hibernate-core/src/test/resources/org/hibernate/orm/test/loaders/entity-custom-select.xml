<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.hibernate.org/xsd/orm/mapping
                https://www.hibernate.org/xsd/orm/mapping/mapping-8.0.xsd"
                 version="8.0">
    <package>org.hibernate.orm.test.loaders</package>

    <entity class="EntityCustomSelectXmlTest$Document" name="Document" access="FIELD" metadata-complete="true">
        <table name="documents"/>
        <hql-select>from Document d where d.id = ?1 and d.deleted = false</hql-select>
        <attributes>
            <id name="id"/>
            <basic name="name"/>
            <basic name="deleted"/>
        </attributes>
    </entity>

</entity-mappings>
