<?xml version="1.0"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping"
                 version="8.0">
    <entity class="org.hibernate.orm.test.locking.ExcludedFromVersioningTestsBase$Phone" name="Phone" metadata-complete="true" access="FIELD">
        <attributes>
            <id name="id"/>
            <basic name="number">
                <column name="`number`"/>
            </basic>
            <basic name="callCount">
                <exclude-from-versioning/>
            </basic>
            <version name="version"/>
        </attributes>
    </entity>
    <entity class="org.hibernate.orm.test.locking.ExcludedFromVersioningTestsBase$Counter" name="Counter" metadata-complete="true" access="FIELD">
        <attributes>
            <id name="id"/>
            <basic name="excludedValue">
                <exclude-from-versioning/>
            </basic>
            <version name="version"/>
        </attributes>
    </entity>
</entity-mappings>
