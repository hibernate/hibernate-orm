<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping" version="8.0">
    <package>org.hibernate.orm.test.mapping.cascade</package>
    <access>FIELD</access>

    <!-- no default-cascade in this document -->
    <entity class="XmlDefaultCascadeTest$Holder" metadata-complete="true">
        <attributes>
            <id name="id"/>
            <one-to-many name="items" target-entity="XmlDefaultCascadeTest$Child">
                <join-column name="holder_id"/>
            </one-to-many>
        </attributes>
    </entity>
</entity-mappings>
