<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping" version="8.0">
    <persistence-unit-metadata>
        <persistence-unit-defaults>
            <default-cascade>merge</default-cascade>
        </persistence-unit-defaults>
    </persistence-unit-metadata>
    <package>org.hibernate.orm.test.mapping.cascade</package>
    <access>FIELD</access>

    <entity class="XmlDefaultCascadeTest$Parent" metadata-complete="true">
        <attributes>
            <id name="id"/>
            <!-- no explicit cascade: the persistence-unit default-cascade should apply -->
            <one-to-many name="children" target-entity="XmlDefaultCascadeTest$Child">
                <join-column name="parent_id"/>
            </one-to-many>
            <one-to-many name="others" target-entity="XmlDefaultCascadeTest$Other">
                <join-column name="parent_id"/>
                <cascade>
                    <cascade-persist/>
                </cascade>
            </one-to-many>
            <!-- empty explicit cascade -->
            <one-to-many name="unrelated" target-entity="XmlDefaultCascadeTest$Unrelated">
                <join-column name="parent_id"/>
                <cascade/>
            </one-to-many>
        </attributes>
    </entity>

    <entity class="XmlDefaultCascadeTest$Child" metadata-complete="true">
        <attributes>
            <id name="id"/>
        </attributes>
    </entity>

    <entity class="XmlDefaultCascadeTest$Other" metadata-complete="true">
        <attributes>
            <id name="id"/>
        </attributes>
    </entity>

    <entity class="XmlDefaultCascadeTest$Unrelated" metadata-complete="true">
        <attributes>
            <id name="id"/>
        </attributes>
    </entity>
</entity-mappings>
