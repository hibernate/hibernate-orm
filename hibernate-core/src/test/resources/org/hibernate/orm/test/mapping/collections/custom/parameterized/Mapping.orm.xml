<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping" version="8.0">
    <package>org.hibernate.orm.test.mapping.collections.custom.parameterized</package>
    <attribute-accessor>field</attribute-accessor>
    <default-cascade>none</default-cascade>
    <default-lazy>true</default-lazy>
    <entity class="Entity" metadata-complete="true">
        <table name="Entity"/>
        <dynamic-insert>false</dynamic-insert>
        <dynamic-update>false</dynamic-update>
        <select-before-update>false</select-before-update>
        <batch-size>-1</batch-size>
        <mutable>true</mutable>
        <optimistic-locking>VERSION</optimistic-locking>
        <attributes>
            <id name="name">
                <column name="name" unique="false" nullable="false" insertable="true" updatable="false"/>
                <java-type>org.hibernate.type.descriptor.java.StringJavaType</java-type>
                <jdbc-type>org.hibernate.type.descriptor.jdbc.VarcharJdbcType</jdbc-type>
            </id>
            <element-collection name="values" target-class="java.lang.String" fetch="EAGER" fetch-mode="JOIN" optimistic-lock="true" classification="LIST">
                <collection-type type="org.hibernate.orm.test.mapping.collections.custom.parameterized.DefaultableListType">
                    <parameters name="default" value="Hello"/>
                </collection-type>
                <order-column name="POS"/>
                <mutable>true</mutable>
                <column name="VAL" unique="false" nullable="true" insertable="true" updatable="true"/>
                <java-type>org.hibernate.type.descriptor.java.StringJavaType</java-type>
                <jdbc-type>org.hibernate.type.descriptor.jdbc.VarcharJdbcType</jdbc-type>
                <collection-table name="ENT_VAL">
                    <join-column name="ENT_ID" unique="false" nullable="true" insertable="true" updatable="true"/>
                </collection-table>
            </element-collection>
        </attributes>
    </entity>
</entity-mappings>
