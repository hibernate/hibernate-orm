<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping" version="7.0">
    <entity class="org.hibernate.orm.test.namingstrategy.ImplicitEmbeddableDiscriminatorNamingTest$DirectOwner">
        <attributes>
            <embedded name="pet">
                <attribute-override name="{discriminator}">
                    <column name="xml_kind"/>
                </attribute-override>
            </embedded>
        </attributes>
    </entity>
</entity-mappings>
