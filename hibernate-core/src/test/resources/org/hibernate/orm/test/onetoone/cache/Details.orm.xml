<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping" version="8.0">
    <package>org.hibernate.orm.test.onetoone.cache</package>
    <attribute-accessor>property</attribute-accessor>
    <default-cascade>none</default-cascade>
    <default-lazy>true</default-lazy>
    <mapped-superclass class="org.hibernate.orm.test.onetoone.cache.Details" access="PROPERTY" metadata-complete="true">
        <attributes>
            <basic name="data" fetch="EAGER" optional="true" optimistic-lock="true">
                <generated>NEVER</generated>
                <java-type>org.hibernate.type.descriptor.java.StringJavaType</java-type>
                <jdbc-type>org.hibernate.type.descriptor.jdbc.VarcharJdbcType</jdbc-type>
            </basic>
            <transient name="person"/>
            <transient name="id"/>
        </attributes>
    </mapped-superclass>
    <entity class="DetailsByFK" metadata-complete="true">
        <table name="DetailsByFK"/>
        <dynamic-insert>false</dynamic-insert>
        <dynamic-update>false</dynamic-update>
        <select-before-update>false</select-before-update>
        <caching access="READ_WRITE" includeLazy="true"/>
        <batch-size>-1</batch-size>
        <mutable>true</mutable>
        <optimistic-locking>VERSION</optimistic-locking>
        <attributes>
            <id name="id">
                <column name="id" unique="false" nullable="false" insertable="true" updatable="false"/>
                <generated-value generator="id-id-generator"/>
                <generic-generator name="id-id-generator" class="foreign">
                    <parameter name="property" value="person"/>
                </generic-generator>
                <unsaved-value>0</unsaved-value>
                <java-type>org.hibernate.type.descriptor.java.IntegerJavaType</java-type>
                <jdbc-type>org.hibernate.type.descriptor.jdbc.IntegerJdbcType</jdbc-type>
            </id>
            <one-to-one name="person" target-entity="PersonByFK" fetch="LAZY" fetch-mode="SELECT" optional="false" orphan-removal="false">
                <foreign-key/>
                <cascade/>
            </one-to-one>
        </attributes>
    </entity>
    <entity class="DetailsByRef" metadata-complete="true">
        <table name="DetailsByRef"/>
        <dynamic-insert>false</dynamic-insert>
        <dynamic-update>false</dynamic-update>
        <select-before-update>false</select-before-update>
        <caching access="READ_WRITE" includeLazy="true"/>
        <batch-size>-1</batch-size>
        <mutable>true</mutable>
        <optimistic-locking>VERSION</optimistic-locking>
        <attributes>
            <id name="id">
                <column name="id" unique="false" nullable="false" insertable="true" updatable="false"/>
                <generated-value generator="id-id-generator"/>
                <generic-generator name="id-id-generator" class="native"/>
                <unsaved-value>0</unsaved-value>
                <java-type>org.hibernate.type.descriptor.java.IntegerJavaType</java-type>
                <jdbc-type>org.hibernate.type.descriptor.jdbc.IntegerJdbcType</jdbc-type>
            </id>
            <many-to-one name="person" target-entity="PersonByRef" fetch="LAZY" fetch-mode="SELECT" optional="true" not-found="EXCEPTION">
                <join-column name="personId" unique="false" nullable="true" insertable="true" updatable="true"/>
                <cascade/>
            </many-to-one>
        </attributes>
    </entity>
</entity-mappings>
