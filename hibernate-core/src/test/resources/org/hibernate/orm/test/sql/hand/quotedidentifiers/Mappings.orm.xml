<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping" version="8.0">
    <package>org.hibernate.orm.test.sql.hand.quotedidentifiers</package>
    <named-native-query name="query-person">
        <query>select p."pId", p."pName" from "Person" p</query>
    </named-native-query>
    <sql-result-set-mapping name="person-scalar">
        <column-result name="`pId`"/>
        <column-result name="`pName`"/>
    </sql-result-set-mapping>
    <sql-result-set-mapping name="person-entity-basic">
        <entity-result entity-class="org.hibernate.orm.test.sql.hand.quotedidentifiers.Person"/>
    </sql-result-set-mapping>
    <sql-result-set-mapping name="person-entity-expanded">
        <entity-result entity-class="org.hibernate.orm.test.sql.hand.quotedidentifiers.Person">
            <field-result name="id" column="`pId`"/>
            <field-result name="name" column="`pName`"/>
        </entity-result>
    </sql-result-set-mapping>
    <entity class="Person" metadata-complete="true">
        <table name="`Person`"/>
        <attributes>
            <id name="id">
                <column name="`pId`"/>
                <generated-value generator="id-id-generator"/>
                <generic-generator name="id-id-generator" class="increment"/>
                <unsaved-value>0</unsaved-value>
            </id>
            <basic name="name" optional="false">
                <column name="`pName`"/>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
