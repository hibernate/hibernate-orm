<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE entity-mappings [
		<!ENTITY package "org.hibernate.orm.test.util.dtd">
]>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
				 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_2.xsd"
				 version="3.2">

	<package>&package;</package>
	<access>FIELD</access>

	<entity class="Parent">
		<attributes>
			<id name="id">
				<generated-value/>
			</id>
			<one-to-many name="children" target-entity="Child" mapped-by="parent"/>
		</attributes>
	</entity>

	<entity class="Child">
		<attributes>
			<id name="id">
				<generated-value/>
			</id>
			<basic name="age"/>
			<many-to-one name="parent" target-entity="Parent"/>
		</attributes>
	</entity>
</entity-mappings>
