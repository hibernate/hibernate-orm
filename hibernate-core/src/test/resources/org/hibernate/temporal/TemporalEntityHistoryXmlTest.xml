<?xml version="1.0"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping"
                 version="8.0">
    <entity class="org.hibernate.temporal.AbstractTemporalEntityHistoryTest$TemporalEntity4"
            name="TemporalEntity4" metadata-complete="true" access="FIELD">
        <temporal-versioning row-start="effective_from" row-end="effective_to"/>
        <attributes>
            <id name="id"/>
            <basic name="text"/>
            <basic name="excluded">
                <exclude-from-temporal-versioning/>
            </basic>
            <version name="version"/>
            <one-to-many name="children" mapped-by="parent"/>
            <element-collection name="strings">
                <temporal-versioning/>
            </element-collection>
            <element-collection name="map">
                <temporal-versioning/>
            </element-collection>
            <element-collection name="list">
                <order-column/>
                <temporal-versioning/>
            </element-collection>
        </attributes>
    </entity>
    <entity class="org.hibernate.temporal.AbstractTemporalEntityHistoryTest$TemporalChild4"
            name="TemporalChild4" metadata-complete="true" access="FIELD">
        <temporal-versioning row-start="effective_from" row-end="effective_to"/>
        <attributes>
            <id name="id"/>
            <basic name="text"/>
            <version name="version"/>
            <many-to-one name="parent"/>
            <many-to-many name="friends">
                <temporal-versioning/>
            </many-to-many>
        </attributes>
    </entity>
</entity-mappings>
