<?xml version="1.0"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping"
                 version="8.0">
    <entity class="org.hibernate.temporal.audit.AuditEntityXmlMappingTest$XmlAuditEntity" name="XmlAuditEntity" metadata-complete="true" access="FIELD">
        <audited/>
        <attributes>
            <id name="id"/>
            <basic name="text"/>
            <version name="version"/>
            <element-collection name="stringSet">
                <column name="str_value"/>
                <collection-table name="xml_audit_entity_strings">
                    <join-column name="entity_id"/>
                </collection-table>
                <audited/>
            </element-collection>
        </attributes>
    </entity>
</entity-mappings>
