<?xml version="1.0"?>
<entity-mappings xmlns="https://www.hibernate.org/xsd/orm/mapping"
                 version="8.0">
    <entity class="org.hibernate.temporal.audit.AbstractChangelogEntityTest$MyRevisionInfo" name="MyRevisionInfo"
            metadata-complete="true" access="FIELD">
        <changelog/>
        <attributes>
            <id name="id">
                <column name="REV"/>
                <generated-value/>
                <changeset-id/>
            </id>
            <basic name="timestamp">
                <column name="REVTSTMP"/>
                <changelog-timestamp/>
            </basic>
        </attributes>
    </entity>
    <entity class="org.hibernate.temporal.audit.AbstractChangelogEntityTest$Book" name="RevAnnotBook"
            metadata-complete="true" access="FIELD">
        <audited/>
        <attributes>
            <id name="id"/>
            <basic name="title"/>
        </attributes>
    </entity>
</entity-mappings>
