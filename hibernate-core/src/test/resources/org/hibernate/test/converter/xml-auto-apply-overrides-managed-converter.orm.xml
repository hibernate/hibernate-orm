<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="http://xmlns.jcp.org/xml/ns/persistence/orm" version="2.2">
    <package>org.hibernate.orm.test.mapping.converted.converter</package>
    <entity class="org.hibernate.orm.test.mapping.converted.converter.JpaOrmXmlRegisterConverterTest$Customer"
            access="FIELD" metadata-complete="true">
        <table name="Customer"/>
        <attributes>
            <id name="id"/>
            <!-- No explicit convert: the XML converter declaration must auto-apply. -->
            <basic name="emailAddress"/>
        </attributes>
    </entity>
    <converter class="org.hibernate.orm.test.mapping.converted.converter.JpaOrmXmlRegisterConverterTest$EmailAddressConverter"
            auto-apply="true"/>
</entity-mappings>
