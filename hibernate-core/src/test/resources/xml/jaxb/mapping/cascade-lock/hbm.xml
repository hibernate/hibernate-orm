<hibernate-mapping xmlns="http://www.hibernate.org/xsd/orm/hbm" package="org.hibernate.orm.test.boot.jaxb.mapping.cascade">
    <class name="Parent">
        <id name="id"/>
        <many-to-one name="child" class="Child" cascade="lock"/>
    </class>

    <class name="Child">
        <id name="id"/>
    </class>
</hibernate-mapping>
