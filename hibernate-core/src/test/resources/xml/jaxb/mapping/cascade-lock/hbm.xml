<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.hibernate.orm.test.boot.jaxb.mapping.cascade">
    <class name="Parent">
        <id name="id"/>
        <many-to-one name="child" class="Child" cascade="lock"/>
    </class>

    <class name="Child">
        <id name="id"/>
    </class>
</hibernate-mapping>
