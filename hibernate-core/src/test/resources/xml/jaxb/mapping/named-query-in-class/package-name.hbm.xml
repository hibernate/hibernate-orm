<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="org.hibernate.orm.test.boot.jaxb.mapping">

	<class name="PackageEntity">
		<id name="id">
			<generator class="assigned" />
		</id>
		<property name="name"/>
	</class>

	<!-- Query defined at root level (outside class) should NOT be prefixed with entity name -->
	<query name="findAllPackageEntities">from PackageEntity</query>

</hibernate-mapping>
