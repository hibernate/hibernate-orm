<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="org.hibernate.orm.test.boot.jaxb.mapping">

    <class name="SimpleEntity">
        <id name="id">
            <generator class="increment"/>
        </id>
        <property name="name" not-null="true"/>
    </class>

    <sql-query name="findScalars">
        <return-scalar column="col_name" type="string"/>
        <return-scalar column="col_value" type="long"/>
        <return-scalar column="col_untyped"/>
        select col_name, col_value, col_untyped from some_table
    </sql-query>

    <sql-query name="findEntityByName">
        <return entity-name="org.hibernate.orm.test.boot.jaxb.mapping.SimpleEntity" alias="e"/>
        select id, name from SimpleEntity e
    </sql-query>

</hibernate-mapping>
