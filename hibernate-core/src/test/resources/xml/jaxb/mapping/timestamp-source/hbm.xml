<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.hibernate.orm.test.boot.jaxb.mapping.timestampsource">

    <class name="DbSourcedEntity">
        <id name="id">
            <generator class="native"/>
        </id>
        <timestamp name="lastModified" column="last_modified" source="db"/>
        <property name="name"/>
    </class>

    <class name="VmSourcedEntity">
        <id name="id">
            <generator class="native"/>
        </id>
        <timestamp name="lastModified" source="vm"/>
        <property name="name"/>
    </class>

</hibernate-mapping>
